# =====================================================================
# POWER-SUB Backend Environment Configuration
# =====================================================================

# Application Environment: 'development' or 'production'
APP_ENV=development

# Enable FastAPI debug mode (development only)
DEBUG=false

# SQLite Database File Path
DATABASE_PATH=data/power_sub.db

# Temporary directory for file uploads
UPLOAD_TEMP_DIR=data/tmp

# Directory for generated reports (CSV & PDF)
REPORTS_DIR=generated_reports

# File Upload Limits
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=100
MAX_PDF_PAGES=100
MAX_XLSX_UNCOMPRESSED_MB=100
MAX_SHEETS=10

# CORS Allowed Origins (comma-separated; NEVER use '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# Optional API Key Authentication. If non-empty, requests to /api/v1/* (except /health) require X-API-Key header.
API_KEY=

# Rate Limiting (requests per minute per client IP for upload/report endpoints)
RATE_LIMIT_PER_MINUTE=60

# Data Lifecycle (hours before datasets auto-expire; 0 disables auto-expiry)
DATASET_TTL_HOURS=168

# Result persistence & reproducibility
PERSIST_RESULTS=true
RANDOM_SEED=42
DEFAULT_CONTAMINATION=0.05
MIN_RECORDS_FOR_ML=30
REQUEST_TIMEOUT_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
